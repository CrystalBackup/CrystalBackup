<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Crystal Backup — installation self-check</title>
<style>{{ css }}</style>
</head>
<body>
<div class="wrap">

  <p class="eyebrow">Crystal Backup · self-check · report v{{ .ReportVersion }}</p>
  <h1>Installation self-check</h1>
  <p class="lede">What is actually running, what exists, and what the alert rules say about it — evaluated from live object state, with no Prometheus in the loop.</p>
  <div class="meta">
    <span><b>Generated</b> {{ ts .GeneratedAt }}</span>
    <span><b>Operator</b> {{ with .Operator.AppVersion }}{{ . }}{{ else }}{{ .Operator.BuildVersion }}{{ end }}</span>
    <span><b>Kubernetes</b> {{ with .Cluster.KubernetesVersion }}{{ . }}{{ else }}unknown{{ end }}</span>
    <span><b>Redaction</b> {{ .Redaction.Mode }}{{ if eq .Redaction.SaltSource "caller-supplied" }} · caller-supplied salt{{ end }}</span>
  </div>

  <section class="verdict {{ if eq .Verdict.Status "unhealthy" }}unhealthy{{ else if eq .Verdict.Status "degraded" }}degraded{{ end }}">
    <div class="head"><span class="dot"></span>{{ .Verdict.Summary }}</div>
    <p>
      {{ .Verdict.OK }} rule(s) clean · {{ .Verdict.Breached }} breached{{ if has .Verdict.Critical }} ({{ .Verdict.Critical }} critical){{ end }} ·
      {{ .Verdict.NotEvaluated }} not evaluated · {{ .Verdict.Errored }} errored.
      A rule that could not be evaluated is <b>not</b> a passing rule — only Prometheus can answer those, and this report says so rather than showing green.
    </p>
  </section>

  {{ if eq .Redaction.Mode "hashed" }}
  <div class="note"><b>Identifiers are redacted{{ if eq .Redaction.SaltSource "caller-supplied" }} with a caller-supplied salt.</b> {{ else }}.</b> {{ end }}{{ .Redaction.Note }}</div>
  {{ else }}
  <div class="note"><b>This report is UNREDACTED.</b> {{ .Redaction.Note }}</div>
  {{ end }}

  <h2>Installation</h2>
  <div class="axes">
    <div class="axis"><div class="name">Operator build</div><div class="v">{{ .Operator.BuildVersion }}</div></div>
    <div class="axis"><div class="name">Chart / appVersion</div><div class="v">{{ with .Operator.AppVersion }}{{ . }}{{ else }}—{{ end }}</div></div>
    <div class="axis"><div class="name">Backups retained</div><div class="v">{{ .Inventory.Backups.Total }}</div></div>
    <div class="axis"><div class="name">Residual objects</div><div class="v {{ if has .Leaks.Totals.Residual }}crit{{ else }}ok{{ end }}">{{ .Leaks.Totals.Residual }}</div></div>
  </div>
  {{ with .Operator.VersionNote }}<p class="faint">{{ . }}</p>{{ end }}
  <p class="faint">
    Operator namespace <code>{{ .Operator.Namespace }}</code>{{ with .Cluster.ClusterID }} · cluster ID <code>{{ . }}</code>{{ end }}{{ with .Cluster.SnapshotAPI }} · snapshot API: {{ . }}{{ end }}
  </p>

  <h2>Images actually running<span class="n">from status.containerStatuses[].imageID</span></h2>
  <p class="muted">{{ .Images.Note }}</p>
  {{ if .Images.Running }}
  <div class="scroll">
  <table>
    <thead><tr><th>Role</th><th>Container</th><th>Repository</th><th>Tag</th><th>Running digest</th><th>State</th><th>Restarts</th></tr></thead>
    <tbody>
    {{ range .Images.Running }}
      <tr>
        <td>{{ .Role }}</td>
        <td class="mono">{{ .Container }}</td>
        <td class="mono">{{ with .Repository }}{{ . }}{{ else }}—{{ end }}</td>
        <td class="mono">{{ with .Tag }}{{ . }}{{ else }}—{{ end }}</td>
        <td>{{ if .Digest }}<span class="sha">{{ .Digest }}</span>{{ else }}<span class="chip warn">NOT RESOLVED</span>{{ end }}</td>
        <td class="mono">{{ .State }}</td>
        <td class="mono">{{ .Restarts }}</td>
      </tr>
    {{ end }}
    </tbody>
  </table>
  </div>
  {{ else }}
  <p class="muted">No pod was readable in the operator namespace, so nothing here describes what is deployed. See the diagnostics at the foot of this page.</p>
  {{ end }}
  {{ if .Images.Declared }}
  <p class="faint">Configured (not observed): {{ range $k, $v := .Images.Declared }}<code>{{ $k }}={{ $v }}</code> {{ end }}</p>
  {{ end }}

  <h2>Custom resource definitions<span class="n">source: {{ .CRDs.Source }}</span></h2>
  {{ with .CRDs.Reason }}<p class="muted">{{ . }}</p>{{ end }}
  {{ if .CRDs.Items }}
  <div class="scroll">
  <table>
    <thead><tr><th>Name</th><th>Served versions</th><th>Storage version</th><th>Generated by</th></tr></thead>
    <tbody>
    {{ range .CRDs.Items }}
      <tr>
        <td class="mono">{{ .Name }}</td>
        <td class="mono">{{ range .Versions }}{{ . }} {{ end }}</td>
        <td class="mono">{{ with .StorageVersion }}{{ . }}{{ else }}—{{ end }}</td>
        <td class="mono">{{ with .GeneratedBy }}{{ . }}{{ else }}—{{ end }}</td>
      </tr>
    {{ end }}
    </tbody>
  </table>
  </div>
  {{ end }}

  <h2>Rule verdicts<span class="n">thresholds read from the alert table, never restated</span></h2>
  {{ range .Rules }}
  <div class="rule">
    <div class="top">
      <span class="chip {{ statusRank .Status }}">{{ statusWord .Status }}</span>
      <span class="nm">{{ .Name }}</span>
      <span class="sev {{ sevClass .Severity }}">{{ .Severity }}</span>
    </div>
    <div class="bound">{{ .Threshold.Description }}</div>
    {{ if eq .Status "breached" }}
      <div class="why">{{ .Summary }}</div>
      <ul>
      {{ range .Breaches }}
        <li>{{ .Detail }}<span class="lbl">{{ labelList .Labels }}</span></li>
      {{ end }}
      </ul>
      <div class="why"><b>What to do:</b> {{ .Remedy }}</div>
    {{ else if eq .Status "notEvaluated" }}
      <div class="why">{{ .Reason }}</div>
    {{ else if eq .Status "error" }}
      <div class="why">The predicate could not run: {{ .Reason }}</div>
    {{ end }}
    {{ with .Fidelity }}<div class="caveat"><b>Measurement caveat.</b> {{ . }}</div>{{ end }}
  </div>
  {{ end }}

  <h2>Locations<span class="n">{{ len .Inventory.Locations }}</span></h2>
  {{ if .Inventory.Locations }}
  <div class="scroll">
  <table>
    <thead><tr><th>Scope</th><th>Name</th><th>Namespace</th><th>Mode</th><th>Endpoint</th><th>Bucket</th><th>Ready</th><th>Age</th></tr></thead>
    <tbody>
    {{ range .Inventory.Locations }}
      <tr>
        <td>{{ .Scope }}{{ if .Default }} <span class="chip low">default</span>{{ end }}</td>
        <td class="mono">{{ .Name }}</td>
        <td class="mono">{{ with .Namespace }}{{ . }}{{ else }}—{{ end }}</td>
        <td class="mono">{{ .Mode }}</td>
        <td class="mono">{{ .Endpoint }}{{ if .CustomCA }} <span class="chip low">custom CA</span>{{ end }}</td>
        <td class="mono">{{ .Bucket }}</td>
        <td class="mono">{{ with .Ready }}{{ . }}{{ else }}{{ .Phase }}{{ end }}</td>
        <td class="mono">{{ days .AgeDays }}</td>
      </tr>
    {{ end }}
    </tbody>
  </table>
  </div>
  {{ else }}<p class="muted">No location exists. Nothing can be backed up.</p>{{ end }}

  <h2>Repositories<span class="n">{{ len .Inventory.Repositories }}</span></h2>
  {{ if .Inventory.Repositories }}
  <div class="scroll">
  <table>
    <thead><tr><th>Name</th><th>Scope</th><th>Init</th><th>Snapshots</th><th>Size</th><th>Last check</th><th>Last prune</th><th>Discovery</th><th>Stale locks</th></tr></thead>
    <tbody>
    {{ range .Inventory.Repositories }}
      <tr>
        <td class="mono">{{ .Name }}</td>
        <td class="mono">{{ .Scope }}{{ with .OwnerNamespace }} / {{ . }}{{ end }}</td>
        <td class="mono">{{ boolWord .Initialized }}</td>
        <td class="mono">{{ .SnapshotCount }}</td>
        <td class="mono">{{ bytes .SizeBytes }}</td>
        <td class="mono">{{ if .LastCheck }}{{ days .CheckAgeDays }} ago · {{ .CheckResult }}{{ else }}never{{ end }}</td>
        <td class="mono">{{ if .LastPrune }}{{ days .PruneAgeDays }} ago{{ else }}never{{ end }}</td>
        <td class="mono">{{ trip .DiscoverySuccess }}{{ if .DiscoverySuccess }} · {{ .ProjectedBackups }} projected, {{ .OrphanSnapshots }} orphan{{ end }}</td>
        <td class="mono">{{ .StaleLocks }}</td>
      </tr>
    {{ end }}
    </tbody>
  </table>
  </div>
  {{ else }}<p class="muted">No repository exists yet.</p>{{ end }}

  <h2>Schedules<span class="n">{{ len .Inventory.Schedules }}</span></h2>
  {{ if .Inventory.Schedules }}
  <div class="scroll">
  <table>
    <thead><tr><th>Origin</th><th>Name</th><th>Namespace</th><th>Cron</th><th>Period</th><th>Paused</th><th>Last success</th><th>Age</th></tr></thead>
    <tbody>
    {{ range .Inventory.Schedules }}
      <tr>
        <td>{{ .Origin }}{{ if .MatchedNamespaces }} <span class="chip low">{{ .MatchedNamespaces }} ns</span>{{ end }}</td>
        <td class="mono">{{ .Name }}</td>
        <td class="mono">{{ with .Namespace }}{{ . }}{{ else }}—{{ end }}</td>
        <td class="mono">{{ .Cron }}{{ if not .CronValid }} <span class="chip crit">UNPARSEABLE</span>{{ end }}</td>
        <td class="mono">{{ if .CronValid }}{{ printf "%.1f h" .PeriodHours }}{{ else }}—{{ end }}</td>
        <td class="mono">{{ if .Paused }}<span class="chip warn">paused</span>{{ else }}no{{ end }}</td>
        <td class="mono">{{ hours .LastSuccessAgeHours }}</td>
        <td class="mono">{{ days .AgeDays }}</td>
      </tr>
    {{ end }}
    </tbody>
  </table>
  </div>
  {{ else }}<p class="muted">No schedule exists. Nothing is being backed up on a timer.</p>{{ end }}

  <h2>External syncs<span class="n">{{ len .Inventory.Syncs }}</span></h2>
  {{ if .Inventory.Syncs }}
  <div class="scroll">
  <table>
    <thead><tr><th>Scope</th><th>Name</th><th>Source → destination</th><th>Mode</th><th>Paused</th><th>Phase</th><th>Last success</th><th>Lag</th></tr></thead>
    <tbody>
    {{ range .Inventory.Syncs }}
      <tr>
        <td>{{ .Scope }}</td>
        <td class="mono">{{ .Name }}</td>
        <td class="mono">{{ .Source }} → {{ .Destination }}</td>
        <td class="mono">{{ .Mode }}</td>
        <td class="mono">{{ if .Paused }}<span class="chip warn">paused</span>{{ else }}no{{ end }}</td>
        <td class="mono">{{ .Phase }}</td>
        <td class="mono">{{ hours .LastSuccessAgeHours }}</td>
        <td class="mono">{{ if has .Lag }}<span class="chip warn">{{ .Lag }}</span>{{ else }}0{{ end }}</td>
      </tr>
    {{ end }}
    </tbody>
  </table>
  </div>
  {{ else }}<p class="muted">No external sync is configured. There is no second copy.</p>{{ end }}

  <h2>Restore points<span class="n">{{ .Inventory.Backups.Total }} Backup objects</span></h2>
  {{ if .Inventory.Backups.ByPhase }}
  <div class="axes">
  {{ range $phase, $n := .Inventory.Backups.ByPhase }}
    <div class="axis"><div class="name">{{ $phase }}</div><div class="v">{{ $n }}</div></div>
  {{ end }}
  </div>
  <p class="faint">Oldest retained success {{ tsp .Inventory.Backups.OldestSuccess }} · newest {{ tsp .Inventory.Backups.NewestSuccess }}</p>
  {{ else }}<p class="muted">No Backup object exists. Nothing has been captured, or nothing has been retained.</p>{{ end }}

  <h2>Leak indicators<span class="n">grace {{ .Leaks.GraceMinutes }} min</span></h2>
  <p class="muted">{{ .Leaks.Note }}</p>
  {{ if .Leaks.Kinds }}
  <div class="scroll">
  <table>
    <thead><tr><th>Kind</th><th>Total managed</th><th>Residual</th><th>Oldest residual</th></tr></thead>
    <tbody>
    {{ range .Leaks.Kinds }}
      <tr>
        <td class="mono">{{ .Kind }}</td>
        <td class="mono">{{ .Total }}</td>
        <td class="mono">{{ if has .Residual }}<span class="chip crit">{{ .Residual }}</span>{{ else }}0{{ end }}</td>
        <td class="mono">{{ if has .Residual }}{{ .OldestAgeHours }} h{{ else }}—{{ end }}</td>
      </tr>
    {{ end }}
    </tbody>
  </table>
  </div>
  {{ else }}<p class="muted">No Crystal Backup-managed exposure object exists at all.</p>{{ end }}
  {{ if .Leaks.Samples }}
  <p class="faint">Residual sample (oldest first): {{ range .Leaks.Samples }}<code>{{ .Kind }} {{ with .Namespace }}{{ . }}/{{ end }}{{ .Name }} ({{ .AgeHours }}h)</code> {{ end }}</p>
  {{ end }}
  {{ if .Leaks.Unreadable }}
  <p class="faint">Not readable: {{ range .Leaks.Unreadable }}{{ . }}; {{ end }}</p>
  {{ end }}

  {{ if .Diagnostics }}
  <h2>What could not be read<span class="n">{{ len .Diagnostics }}</span></h2>
  <p class="muted">Each entry is a section of this report that is empty because the operator could not look, not because there was nothing there. The distinction is the whole reason this section exists.</p>
  <div class="scroll">
  <table>
    <thead><tr><th>Area</th><th>Error</th><th>What is missing</th></tr></thead>
    <tbody>
    {{ range .Diagnostics }}
      <tr><td class="mono">{{ .Area }}</td><td class="mono">{{ .Message }}</td><td>{{ .Impact }}</td></tr>
    {{ end }}
    </tbody>
  </table>
  </div>
  {{ end }}

  <p class="foot">
    Generated by <code>crystal-backup selfcheck</code> and rendered by <code>crystal-backup report --from &lt;file&gt;</code>.
    Rule verdicts come from the state predicates in <code>internal/alerts</code>, each reading its bound from the same
    <code>Threshold</code> the PromQL is assembled from — so this page and a Prometheus alert cannot disagree about when
    something is late. Image digests are read from what the kubelet resolved, never from chart values.
    This page is self-contained: no network request is made when it is opened.
  </p>

</div>
</body>
</html>
